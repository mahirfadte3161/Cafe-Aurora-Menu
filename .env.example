# Google Sheets API Credentials
# Spreadsheet ID from the Google Sheet URL: https://docs.google.com/spreadsheets/d/<GOOGLE_SHEETS_ID>/edit
GOOGLE_SHEETS_ID=your_google_sheets_id_here

# Service Account Email created in Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_EMAIL=cafe-aurora-menu@your-project-id.iam.gserviceaccount.com

# Service Account Private Key (include -----BEGIN PRIVATE KEY----- and -----END PRIVATE KEY-----)
# In Vercel environment variables, newlines can be entered as \n or direct newlines
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Cloudinary Cloud Name for optimized image delivery
CLOUDINARY_CLOUD_NAME=cafe-aurora
